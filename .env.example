# TriageOps Environment Variables
# Copy this file to .env and fill in your values

# --- Vertex AI ---
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# --- Model Selection ---
# Options: gemini-2.0-flash, gemini-1.5-pro, gemini-1.5-flash
TRIAGEOPS_MODEL=gemini-2.0-flash

# --- API Settings ---
TRIAGEOPS_API_HOST=0.0.0.0
TRIAGEOPS_API_PORT=8000

# --- Logging ---
# Options: DEBUG, INFO, WARNING, ERROR
TRIAGEOPS_LOG_LEVEL=INFO

# --- Runbooks ---
TRIAGEOPS_RUNBOOKS_DIR=runbooks
