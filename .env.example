# TriageOps Environment Variables
# Copy this file to .env and fill in your values

# --- LLM provider (configure ONE) ---
# Option A: Gemini API key
# GEMINI_API_KEY=your-api-key
# Option B: Vertex AI (uses Application Default Credentials / Workload Identity)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# --- Model Selection ---
TRIAGEOPS_MODEL=gemini-3.8-flash

# --- Degraded / offline mode ---
# If no provider is configured, TriageOps runs the offline keyword heuristic and
# marks every report as degraded. If a configured provider FAILS, the API returns
# 503 instead of substituting canned output — set this to 1 only for demos.
TRIAGEOPS_ALLOW_OFFLINE_FALLBACK=0
# Force offline heuristic mode (demos / UI work without an LLM)
TRIAGEOPS_FORCE_OFFLINE=0

# --- API security ---
# Comma-separated API keys. Clients send `X-API-Key: <key>` or `Authorization: Bearer <key>`.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave empty ONLY on a private network — otherwise anyone can spend your LLM quota.
TRIAGEOPS_API_KEYS=
# Comma-separated browser origins allowed via CORS (the bundled UI is same-origin and needs none)
TRIAGEOPS_CORS_ORIGINS=
# Max /triage requests per client per minute (per worker process). 0 disables.
TRIAGEOPS_RATE_LIMIT_PER_MIN=20

# --- API Settings ---
TRIAGEOPS_API_HOST=0.0.0.0
TRIAGEOPS_API_PORT=8000

# --- Logging ---
# Options: DEBUG, INFO, WARNING, ERROR
TRIAGEOPS_LOG_LEVEL=INFO

# --- Runbooks ---
TRIAGEOPS_RUNBOOKS_DIR=runbooks
